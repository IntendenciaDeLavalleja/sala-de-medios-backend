# Aplicación backend independiente en Coolify, igual que sample/backend.
FLASK_APP=wsgi:app
FLASK_CONFIG=production
PORT=5000
SECRET_KEY=CHANGE_TO_RANDOM_HEX_64
WTF_CSRF_SECRET_KEY=CHANGE_TO_ANOTHER_RANDOM_HEX_64
DATABASE_URL=mariadb+mariadbconnector://medios:PASSWORD@mariadb-interno:3306/sala_medios
REDIS_URL=redis://:PASSWORD@redis-interno:6379/0
MINIO_ENDPOINT=minio-interno:9000
MINIO_ACCESS_KEY=CHANGE_TO_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_TO_MINIO_SECRET_KEY
MINIO_BUCKET=lavalleja-medios
MINIO_SECURE=false
MAIL_SERVER=mail.example.test
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=medios@example.test
MAIL_PASSWORD=CHANGE_TO_SMTP_PASSWORD
MAIL_DEFAULT_SENDER="Sala de medios <medios@example.test>"
# URL del frontend público, no la URL del admin/backend.
PUBLIC_BASE_URL=https://medios.lavalleja.uy
CORS_ORIGINS=https://medios.lavalleja.uy
SESSION_COOKIE_SECURE=true
SESSION_HOURS=8
TWO_FACTOR_TTL_MINUTES=10
TWO_FACTOR_MAX_ATTEMPTS=5
TRUSTED_PROXY_COUNT=1
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_BYTES=26214400
MAX_IMAGE_PIXELS=40000000
MAX_ZIP_BYTES=524288000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
